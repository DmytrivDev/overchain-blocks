<?php 
	$iconUrl = $attributes['iconUrl'] ?? '';
	$title   = $attributes['title'] ?? '';
	$text    = $attributes['text'] ?? '';
 ?>

<li class="item-control">
	<?php if( ! empty( $iconUrl ) ): ?>
 <div class="item-control__icon">
 <img src="<?php echo \htmlentities(esc_url( $iconUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
	<?php endif; ?>

	<div class="item-control__box">
 <?php if( ! empty( $title ) ): ?>
 <h3 class="tl4"><?php echo wp_kses_post( $title ); ?></h3>
 <?php endif; ?>

 <?php if( ! empty( $text ) ): ?>
 <div class="txt3 col-alt1 light">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>
	</div>
</li>