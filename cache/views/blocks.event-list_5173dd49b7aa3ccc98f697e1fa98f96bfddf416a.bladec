<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$sectionClass = 'summits ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<?php if( '' !== trim( $content ) ): ?>
	<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="summits__container">
 <div class="summits__wrap section-wrap<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="summits__body section-body">
 <ul class="summits__list">
 <?php echo $content; ?>

 </ul>
 </div>
 </div>
 </div>
	</section>
<?php endif; ?>
