<?php 
	$title         = $attributes['title'] ?? '';
	$backgroundUrl = $attributes['backgroundUrl'] ?? '';
	$imageUrl      = $attributes['imageUrl'] ?? '';
	$linkUrl       = $attributes['linkUrl'] ?? '';
	$linkNewTab    = $attributes['linkNewTab'] ?? false;

	$linkAttrs = ! empty( $linkNewTab ) ? ' target="_blank" rel="noopener noreferrer"' : '';
	$blurUrl   = get_template_directory_uri() . '/assets/img/decor/settlement_blur_1.webp';

	$linkText = function_exists( 'pll__' )
 ? pll__( 'Discover More' )
 : __( 'Discover More', 'overchain-blocks' );
 ?>

<li class="splide__slide card-businesses">
	<?php if( ! empty( $backgroundUrl ) ): ?>
 <div class="card-businesses__bg ibg no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $backgroundUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
	<?php endif; ?>

	<div class="card-businesses__inner">
 <?php if( ! empty( $title ) ): ?>
 <?php if( ! empty( $linkUrl ) ): ?>
 <a href="<?php echo \htmlentities(esc_url( $linkUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" class="tl4"<?php echo $linkAttrs; ?>>
 <?php echo wp_kses_post( $title ); ?>

 </a>
 <?php else: ?>
 <h3 class="tl4"><?php echo wp_kses_post( $title ); ?></h3>
 <?php endif; ?>
 <?php endif; ?>

 <?php if( ! empty( $imageUrl ) ): ?>
 <div class="card-businesses__img">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>

 <?php if( ! empty( $linkUrl ) ): ?>
 <span class="link-more"><?php echo \htmlentities(esc_html( $linkText )??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <?php endif; ?>
	</div>

	<div class="card-businesses__blur no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $blurUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
	</div>
</li>