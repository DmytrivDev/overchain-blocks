<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title = $attributes['title'] ?? '';
	$subtitle = $attributes['subtitle'] ?? '';
	$imageUrl = $attributes['imageUrl'] ?? '';
	$mediaLayout = $attributes['mediaLayout'] ?? 'single';

	// Fixed design asset — the decor shape is identical on every `layered` section
	// in the design, so it is not editable.
	$decorUrl = get_template_directory_uri() . '/assets/img/decor/foundation_decor_1.svg';

	// `steps` is the numbered list (platform-overview); `items` is the icon list
	// used on aviation/igaming; `points` (FM London) reuses the `steps` rows. The default stays `steps` so every Split saved
	// before this attribute existed keeps rendering what it renders today.
	$listStyle = $attributes['listStyle'] ?? 'steps';
	$items     = $attributes['items'] ?? [];

	// Every `.item-actually` in the design uses the same glyph, so it is a fixed
	// design asset rather than a per-item upload.
	$itemIconUrl = get_template_directory_uri() . '/assets/img/icons/actually_icon_2.svg';
	$text = $attributes['text'] ?? '';
	$steps = $attributes['steps'] ?? [];

	// The glow layer arrived with the platform pages; `index.html` and `about.html`
	// have no `actually__blur`, so it defaults to off and blocks saved from those
	// sections keep rendering exactly as before.
	$enableBlur = $attributes['enableBlur'] ?? false;

	$subtitleStyle = $attributes['subtitleStyle'] ?? 'medium';
	$subtitleClass = 'alt-min' === $subtitleStyle ? 'txt2 col-alt1 min-size' : 'txt2 medium';

	$sectionClass = 'actually ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
	// Since design commit 9a29949 the fade sits on __wrap, so the decor and the
	// picture (siblings of __body) fade out together with the text.
	$wrapClass    = 'actually__wrap section-wrap' . overchain_blocks_fade_class( $attributes );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="actually__container">
 <div class="<?php echo \htmlentities(esc_attr( $wrapClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if( $enableBlur ): ?>
 <div class="actually__blur no-select" aria-hidden="true"></div>
 <?php endif; ?>

 <?php /* `single` keeps the original one-layer media; `layered` is the about.html
      variant, where a decorative shape and the picture are separate layers. */ ?>
 <?php if( 'layered' === $mediaLayout ): ?>
 <div class="actually__decor no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $decorUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>

 <?php if( ! empty( $imageUrl ) ): ?>
 <div class="actually__img no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>
 <?php elseif( ! empty( $imageUrl ) ): ?>
 <div class="actually__media no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>

 <?php /* Each `.animated-block` reveals its `.anim-block` children one by one once
      half of it is in view (theme animated-block.js). The whole __wrap fades out
      on scroll when a White Section follows (overchain_blocks_fade_class()). */ ?>
 <div class="actually__body section-body">
 <div class="actually__top animated-block">
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl2 anim-txt anim-block gap-big"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <?php if( ! empty( $subtitle ) ): ?>
 <div class="<?php echo \htmlentities(esc_attr( $subtitleClass )??'', ENT_QUOTES, 'UTF-8', false); ?> anim-block gap-big">
 <p><?php echo wp_kses_post( $subtitle ); ?></p>
 </div>
 <?php endif; ?>
 </div>

 <div class="actually__bottom animated-block">
 <?php if( ! empty( $text ) ): ?>
 <div class="txt2 col-alt1 anim-block gap-big">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>

 <?php if( 'items' === $listStyle ): ?>
 <?php if( ! empty( $items ) ): ?>
 <ul class="actually__list anim-block gap-big">
 <?php $__currentLoopData = $items; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $item): $loop = $this->incrementLoopIndices();  ?>
 <?php $itemText = $item['text'] ?? '';  ?>

 <li class="item-actually">
 <div class="item-actually__icon">
 <img src="<?php echo \htmlentities(esc_url( $itemIconUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>

 <div class="item-actually__content">
 <p><?php echo wp_kses_post( $itemText ); ?></p>
 </div>
 </li>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </ul>
 <?php endif; ?>
 <?php elseif( 'points' === $listStyle ): ?>
 <?php /* FM London: the same `steps` rows (title + text) as a dotted list. */ ?>
 <?php if( ! empty( $steps ) ): ?>
 <ul class="actually__points anim-block gap-big" role="list">
 <?php $__currentLoopData = $steps; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $step): $loop = $this->incrementLoopIndices();  ?>
 <li class="points-actually">
 <?php if( ! empty( $step['title'] ?? '' ) ): ?>
 <h3 class="points-actually__tl"><?php echo wp_kses_post( $step['title'] ); ?></h3>
 <?php endif; ?>

 <?php if( ! empty( $step['text'] ?? '' ) ): ?>
 <div class="points-actually__desc">
 <p><?php echo wp_kses_post( $step['text'] ); ?></p>
 </div>
 <?php endif; ?>
 </li>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </ul>
 <?php endif; ?>
 <?php elseif( ! empty( $steps ) ): ?>
 <ul class="actually__steps anim-block gap-big">
 <?php $__currentLoopData = $steps; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $index => $step): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $stepTitle = $step['title'] ?? '';
 $stepText  = $step['text'] ?? '';
 $stepNumber = str_pad( (string) ( $index + 1 ), 2, '0', STR_PAD_LEFT );
  ?>

 <li class="steps-actually">
 <div class="steps-actually__number"><?php echo \htmlentities(esc_html( $stepNumber )??'', ENT_QUOTES, 'UTF-8', false); ?></div>

 <div class="steps-actually__content">
 <?php if( ! empty( $stepTitle ) ): ?>
 <h3 class="tl5 regular"><?php echo wp_kses_post( $stepTitle ); ?></h3>
 <?php endif; ?>

 <?php if( ! empty( $stepText ) ): ?>
 <div class="steps-actually__desc txt2">
 <p><?php echo wp_kses_post( $stepText ); ?></p>
 </div>
 <?php endif; ?>
 </div>
 </li>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </ul>
 <?php endif; ?>

 <?php echo $this->runChild( 'partials.btn-icon', [
 'text' => $attributes['buttonText'] ?? '',
 'type' => $attributes['buttonType'] ?? 'link',
 'link' => $attributes['buttonLink'] ?? '',
 'newTab' => $attributes['buttonLinkNewTab'] ?? false,
 'anchor' => $attributes['buttonAnchor'] ?? '',
 'popupId' => $attributes['buttonPopupId'] ?? '',
 'icon' => $attributes['buttonIcon'] ?? 'arrow',
 'class' => 'anim-block gap-big',
 ] ); ?>
 </div>
 </div>
 </div>
 </div>
</section>