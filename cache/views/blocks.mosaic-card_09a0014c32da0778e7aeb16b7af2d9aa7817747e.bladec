<?php 
	$variant       = $attributes['variant'] ?? 'default';
	$iconUrl       = $attributes['iconUrl'] ?? '';
	$imageUrl      = $attributes['imageUrl'] ?? '';
	$backgroundUrl = $attributes['backgroundUrl'] ?? '';
	$title         = $attributes['title'] ?? '';
	$text          = $attributes['text'] ?? '';

	$isBig     = 'big' === $variant;
	$isImgTop  = 'img-top' === $variant;
	$usesImage = $isBig || $isImgTop;

	$cardClass = 'card-layer' . ( $isBig ? ' big' : '' ) . ( $isImgTop ? ' img-top' : '' );
 ?>

<li class="<?php echo \htmlentities(esc_attr( $cardClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<?php if( $isBig && ! empty( $backgroundUrl ) ): ?>
 <div class="card-layer__bg ibg no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $backgroundUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
	<?php endif; ?>

	<?php if( $usesImage ): ?>
 <?php if( ! empty( $imageUrl ) ): ?>
 <div class="card-layer__img no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>
	<?php elseif( ! empty( $iconUrl ) ): ?>
 <div class="card-layer__icon">
 <img src="<?php echo \htmlentities(esc_url( $iconUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
	<?php endif; ?>

	<div class="card-layer__box">
 <?php if( ! empty( $title ) ): ?>
 <h3 class="tl5"><?php echo wp_kses_post( $title ); ?></h3>
 <?php endif; ?>

 <?php if( ! empty( $text ) ): ?>
 <div class="txt4 light">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>
	</div>

	<?php /* NOTE: "bpttom" is a typo in the design build, but the CSS matches it. Do not "fix" it. */ ?>
	<?php if( $isBig && ! empty( $attributes['buttonText'] ?? '' ) ): ?>
 <div class="card-layer__bpttom">
 <?php echo $this->runChild( 'partials.btn-def', [
 'text' => $attributes['buttonText'] ?? '',
 'type' => $attributes['buttonType'] ?? 'link',
 'link' => $attributes['buttonLink'] ?? '',
 'newTab' => $attributes['buttonLinkNewTab'] ?? false,
 'anchor' => $attributes['buttonAnchor'] ?? '',
 'popupId' => $attributes['buttonPopupId'] ?? '',
 'style' => 'stl-trn',
 'class' => 'card-layer__btn',
 ] ); ?>
 </div>
	<?php endif; ?>
</li>
