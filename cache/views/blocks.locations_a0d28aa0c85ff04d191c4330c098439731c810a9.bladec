<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';
	$text         = $attributes['text'] ?? '';

	$sectionClass = 'operations ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );

	$decorUrl = get_template_directory_uri() . '/assets/img/decor/operations_decor_1.jpg';
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="operations__container">
 <div class="operations__wrap section-wrap">
 <?php /* Always on: the design's only `.operations` section carries the decor and
      there is no variant without it. */ ?>
 <div class="operations__decor no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $decorUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>

 <div class="operations__body section-body<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if( ! empty( $title ) || ! empty( $text ) ): ?>
 <div class="heading">
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <?php if( ! empty( $text ) ): ?>
 <div class="txt2">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>
 </div>
 <?php endif; ?>

 <ul class="operations__cards">
 <?php echo $content; ?>

 </ul>
 </div>
 </div>
	</div>
</section>
