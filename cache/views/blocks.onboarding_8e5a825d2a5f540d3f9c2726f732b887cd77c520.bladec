<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';
	$sectionClass = 'startright ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="startright__container">
 <div class="startright__wrap section-wrap<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="startright__body section-body">
 <?php if( ! empty( $title ) ): ?>
 <div class="heading aic">
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 </div>
 <?php endif; ?>

 <?php if( '' !== trim( $content ) ): ?>
 <?php /* `.is-threshold` (threshold.js) draws the line and reveals the steps. */ ?>
 <div class="startright__layout anim-cards" data-threshold-desktop="0.4">
 <div class="startright__line" aria-hidden="true"></div>

 <ul class="startright__steps" role="list">
 <?php echo overchain_blocks_stagger( $content, 'item-startright' ); ?>

 </ul>
 </div>
 <?php endif; ?>
 </div>
 </div>
	</div>
</section>
