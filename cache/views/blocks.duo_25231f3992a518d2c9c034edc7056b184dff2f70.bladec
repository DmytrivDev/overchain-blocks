<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';
	$text         = $attributes['text'] ?? '';

	$sectionClass = 'funds ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="funds__container">
 <div class="funds__body section-body">
 <div class="heading">
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl2"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <?php if( ! empty( $text ) ): ?>
 <div class="txt2">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>
 </div>

 <ul class="funds__cards">
 <?php echo $content; ?>

 </ul>
 </div>
	</div>
</section>