<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';
	$text         = $attributes['text'] ?? '';

	// The logo strip that used to live here as a second layout is its own block now
	// — `overchain/logo-grid`. Saved content was converted, so nothing reaches this
	// template with a `layout` attribute any more.
	$sectionClass = 'funds ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="funds__container">
 <div class="funds__wrap section-wrap">
 <div class="funds__body section-body<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="heading">
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <?php if( ! empty( $text ) ): ?>
 <div class="txt2">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>
 </div>

 <ul class="funds__cards anim-cards" data-threshold-desktop="0.3">
 <?php echo overchain_blocks_stagger( $content, 'card-funds' ); ?>

 </ul>
 </div>
 </div>
	</div>
</section>
