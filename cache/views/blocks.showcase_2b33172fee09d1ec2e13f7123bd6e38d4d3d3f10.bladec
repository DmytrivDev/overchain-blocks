<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';

	$sectionClass = 'powerful ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="powerful__container">
 <div class="powerful__wrap section-wrap">
 <div class="powerful__body section-body<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if( ! empty( $title ) ): ?>
 <div class="heading aic">
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 </div>
 <?php endif; ?>

 <ul class="powerful__cards">
 <?php echo $content; ?>

 </ul>
 </div>
 </div>
	</div>
</section>
