<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$enableDecor = $attributes['enableDecor'] ?? false;
	$title = $attributes['title'] ?? '';
	$text = $attributes['text'] ?? '';
	$descText = $attributes['descText'] ?? '';
	$columns  = (string) ( $attributes['columns'] ?? '4' );

	$sectionClass = 'compliant ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
	$cardsClass   = 'compliant__cards' . ( '5' === $columns ? ' cards-column-5' : '' ) . ' anim-cards';
	$decorUrl     = get_template_directory_uri() . '/assets/img/decor/oneflow_dec_1.jpg';
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="compliant__container">
 <div class="compliant__wrap section-wrap">
 <?php if( $enableDecor ): ?>
 <div class="compliant__decor decor1 no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $decorUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>
 <div class="compliant__body section-body<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if( ! empty( $title ) ): ?>
 <div class="heading aic">
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>

 <?php if( ! empty( $text ) ): ?>
 <div class="txt2">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>
 </div>
 <?php endif; ?>

 <ul class="<?php echo \htmlentities(esc_attr( $cardsClass )??'', ENT_QUOTES, 'UTF-8', false); ?>" data-threshold-desktop="0.3">
 <?php echo overchain_blocks_stagger( $content, 'card-compliant' ); ?>

 </ul>

 <?php if( ! empty( $descText ) ): ?>
 <div class="compliant__desc txt3 light">
 <p><?php echo wp_kses_post( $descText ); ?></p>
 </div>
 <?php endif; ?>

 <?php echo $this->runChild( 'partials.btn-icon', [
 'text' => $attributes['buttonText'] ?? '',
 'type' => $attributes['buttonType'] ?? 'link',
 'link' => $attributes['buttonLink'] ?? '',
 'newTab' => $attributes['buttonLinkNewTab'] ?? false,
 'anchor' => $attributes['buttonAnchor'] ?? '',
 'popupId' => $attributes['buttonPopupId'] ?? '',
 'icon' => $attributes['buttonIcon'] ?? 'calendar',
 'class' => 'compliant__btn',
 ] ); ?>
 </div>
 </div>
 </div>
</section>