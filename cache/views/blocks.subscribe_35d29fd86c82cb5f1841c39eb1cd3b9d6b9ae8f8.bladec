<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title = $attributes['title'] ?? '';
	$subtitle = $attributes['subtitle'] ?? '';
	$privacy = $attributes['privacy'] ?? '';
	$imageUrl = $attributes['imageUrl'] ?? '';
	$sectionClass = 'infrastruct mailing ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
	$labelEmail = function_exists( 'pll__' ) ? pll__( 'Enter Your Email' ) : __( 'Enter Your Email', 'overchain' );
	$labelSubmit = function_exists( 'pll__' ) ? pll__( 'Subscribe' ) : __( 'Subscribe', 'overchain' );

	$successTitle = $attributes['successTitle'] ?? '';
	$successDesc = $attributes['successDesc'] ?? '';
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="infrastruct__container">
 <div class="infrastruct__wrap">

 <div class="infrastruct__bg no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( get_template_directory_uri() . '/assets/img/decor/infrastruct_bg_1.jpg' )??'', ENT_QUOTES, 'UTF-8', false); ?>"
 alt="">
 </div>

 <div class="infrastruct__body section-body">

 <?php if( ! empty( $imageUrl ) ): ?>
 <div class="infrastruct__img mouse-prllx">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>

 <div class="infrastruct__content">
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl3"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <?php if( ! empty( $subtitle ) ): ?>
 <div class="txt2 medium">
 <p><?php echo wp_kses_post( $subtitle ); ?></p>
 </div>
 <?php endif; ?>

 <form class="form-infrastruct base-form" method="post" action="" data-success-modal="md-success"
 data-success-modal="md-success" data-success-title="<?php echo \htmlentities(esc_attr( $successTitle )??'', ENT_QUOTES, 'UTF-8', false); ?>"
 data-success-desc="<?php echo \htmlentities(esc_attr( $successDesc )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo wp_nonce_field( 'overchain_subscribe', 'overchain_subscribe_nonce', true, false );  ?>
 <label class="form-infrastruct__label" for="mailing">
 <?php echo \htmlentities(esc_html( $labelEmail )??'', ENT_QUOTES, 'UTF-8', false); ?>

 </label>
 <div class="form-infrastruct__layout">
 <span class="form-infrastruct__input">
 <input type="email" id="mailing" name="mailing" placeholder="Example@company.com"
 data-required>
 </span>
 <button type="submit" class="form-infrastruct__submit btn-def">
 <?php echo \htmlentities(esc_html( $labelSubmit )??'', ENT_QUOTES, 'UTF-8', false); ?>

 </button>
 </div>
 </form>
 </div>

 <?php if( ! empty( $privacy ) ): ?>
 <div class="infrastruct__bottom">
 <div class="text">
 <p><?php echo wp_kses_post( $privacy ); ?></p>
 </div>
 </div>
 <?php endif; ?>

 </div>
 </div>
	</div>
</section>