<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title = $attributes['title'] ?? '';
	$subtitle = $attributes['subtitle'] ?? '';
	$privacy = $attributes['privacy'] ?? '';
	$imageUrl = $attributes['imageUrl'] ?? '';
	$mediaType = $attributes['mediaType'] ?? 'image';
	$slides = $attributes['slides'] ?? [];

	$isSlider = 'slider' === $mediaType;

	$sectionClass = 'infrastruct mailing ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );

	// The slider layout re-flows the whole body: extra body classes, no side image,
	// and the form moves down into __bottom. See events.html in the design build.
	$bodyClass = 'infrastruct__body section-body' . ( $isSlider ? ' with-splide pis2' : '' ) . overchain_blocks_fade_class( $attributes );

	$labelEmail = function_exists( 'pll__' ) ? pll__( 'Enter Your Email' ) : __( 'Enter Your Email', 'overchain' );
	$labelSubmit = function_exists( 'pll__' ) ? pll__( 'Subscribe' ) : __( 'Subscribe', 'overchain' );

	$successTitle = $attributes['successTitle'] ?? '';
	$successDesc = $attributes['successDesc'] ?? '';

	$formArgs = compact( 'labelEmail', 'labelSubmit', 'successTitle', 'successDesc' );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="infrastruct__container">
 <div class="infrastruct__wrap section-wrap">

 <div class="infrastruct__bg no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( get_template_directory_uri() . '/assets/img/decor/infrastruct_bg_1.jpg' )??'', ENT_QUOTES, 'UTF-8', false); ?>"
 alt="">
 </div>

 <div class="<?php echo \htmlentities(esc_attr( $bodyClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">

 <?php if( ! $isSlider && ! empty( $imageUrl ) ): ?>
 <div class="infrastruct__img img1 mouse-prllx">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>

 <div class="infrastruct__content">
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl3 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <?php if( ! empty( $subtitle ) ): ?>
 <div class="txt2 medium">
 <p><?php echo wp_kses_post( $subtitle ); ?></p>
 </div>
 <?php endif; ?>

 <?php if( ! $isSlider ): ?>
 <?php echo $this->runChild( 'partials.subscribe-form', $formArgs ); ?>
 <?php endif; ?>
 </div>

 <?php if( $isSlider && ! empty( $slides ) ): ?>
 <div class="infrastruct__splide">
 <div class="splide" data-lock>
 <div class="splide__track">
 <ul class="splide__list">
 <?php $__currentLoopData = $slides; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $slide): $loop = $this->incrementLoopIndices();  ?>
 <?php $slideUrl = $slide['imageUrl'] ?? '';  ?>

 <?php if( ! empty( $slideUrl ) ): ?>
 <li class="splide__slide splide-infrastruct ibg">
 <img src="<?php echo \htmlentities(esc_url( $slideUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </li>
 <?php endif; ?>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </ul>
 </div>
 </div>
 </div>
 <?php endif; ?>

 <?php if( $isSlider || ! empty( $privacy ) ): ?>
 <div class="infrastruct__bottom">
 <?php if( $isSlider ): ?>
 <?php echo $this->runChild( 'partials.subscribe-form', $formArgs ); ?>
 <?php endif; ?>

 <?php if( ! empty( $privacy ) ): ?>
 <div class="text">
 <p><?php echo wp_kses_post( $privacy ); ?></p>
 </div>
 <?php endif; ?>
 </div>
 <?php endif; ?>

 </div>
 </div>
	</div>
</section>
