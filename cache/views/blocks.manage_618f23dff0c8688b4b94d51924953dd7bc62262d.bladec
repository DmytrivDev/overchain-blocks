<?php 
	$noPaddingTop     = $attributes['noPaddingTop'] ?? false;
	$enableBackground = $attributes['enableBackground'] ?? true;
	$title            = $attributes['title'] ?? '';

	$sectionClass = 'manage ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );

	// Same on every page that has the section — a fixed theme asset, not an attribute.
	$backgroundUrl = get_template_directory_uri() . '/assets/img/decor/introflow_bg_1.jpg';
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="manage__container">
 <div class="manage__wrap section-wrap">
 <?php if( $enableBackground ): ?>
 <div class="manage__bg no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $backgroundUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="" loading="lazy" decoding="async">
 </div>
 <?php endif; ?>

 <div class="manage__body section-body<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if( ! empty( $title ) ): ?>
 <div class="heading aic mbe2">
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 </div>
 <?php endif; ?>

 <ul class="manage__cards">
 <?php echo $content; ?>

 </ul>
 </div>
 </div>
	</div>
</section>
