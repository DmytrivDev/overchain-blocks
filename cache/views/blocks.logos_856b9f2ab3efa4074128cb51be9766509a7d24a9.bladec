<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$logos        = $attributes['logos'] ?? [];

	$sectionClass = 'platform ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<?php if( ! empty( $logos ) ): ?>
	<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="platform__container">
 <div class="platform__body section-body">
 <h2 class="visually-hidden">Platforms</h2>

 <ul class="platform__list">
 <?php $__currentLoopData = $logos; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $logo): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $imageUrl = $logo['imageUrl'] ?? '';
 $link     = $logo['link'] ?? '';
  ?>

 <?php if( ! empty( $imageUrl ) ): ?>
 <li class="item-platform">
 <?php if( ! empty( $link ) ): ?>
 <a
 href="<?php echo \htmlentities(esc_url( $link )??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="item-platform__logo"
 target="_blank"
 rel="noopener noreferrer"
 >
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </a>
 <?php else: ?>
 <div class="item-platform__logo">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>
 </li>
 <?php endif; ?>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </ul>
 </div>
 </div>
	</section>
<?php endif; ?>