<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';
	$sectionClass = 'brokers ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="brokers__container">
 <div class="brokers__wrap section-wrap<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php /* The background is the design's fixed artwork, shipped in the theme. */ ?>
 <div class="brokers__decor no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( get_template_directory_uri() . '/assets/img/decor/brokers_decor_1.jpg' )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="" loading="lazy" decoding="async">
 </div>

 <div class="brokers__body section-body">
 <?php if( ! empty( $title ) ): ?>
 <div class="heading mbe2">
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 </div>
 <?php endif; ?>

 <?php if( '' !== trim( $content ) ): ?>
 <ul class="brokers__list anim-cards" role="list" data-threshold-desktop="0.3">
 <?php echo overchain_blocks_stagger( $content, 'card-brokers' ); ?>

 </ul>
 <?php endif; ?>
 </div>
 </div>
	</div>
</section>
