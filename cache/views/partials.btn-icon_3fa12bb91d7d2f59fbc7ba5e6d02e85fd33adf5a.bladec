<?php 
	$type = $type ?? 'link';
	$icon = $icon ?? 'calendar';
	$class = $class ?? '';
	// Raw `style` attribute value, e.g. `--i: 3` for a staggered reveal. Not to be
	// confused with btn-def's `style`, which is a style-modifier class.
	$inlineStyle = $inlineStyle ?? '';
 ?>

<?php /* "Transparent" is the plain theme button: no icon, btn-def styling. Handled here
 so every block that already includes this partial supports it for free. */ ?>
<?php if( 'transparent' === $icon ): ?>
	<?php echo $this->runChild( 'partials.btn-def', [
 'text' => $text ?? '',
 'type' => $type,
 'link' => $link ?? '',
 'newTab' => $newTab ?? false,
 'anchor' => $anchor ?? '',
 'popupId' => $popupId ?? '',
 'style' => 'stl-trn',
 'class' => $class,
 'inlineStyle' => $inlineStyle,
	] ); ?>
<?php else: ?>
	<?php 
 $data = overchain_resolve_button_data( [
 'buttonType' => $type,
 'buttonLink' => $link ?? '',
 'buttonLinkNewTab' => $newTab ?? false,
 'buttonAnchor' => $anchor ?? '',
 'buttonPopupId' => $popupId ?? '',
 ] );
 $href = $data['href'];
 $attrs = $data['attrs'];
 $iconUrl = get_template_directory_uri() . '/assets/img/icons/' . ( 'arrow' === $icon ? 'btn_2.svg' : 'btn_1.svg' );
	 ?>

	<?php if( ! empty( $text ?? '' ) ): ?>
 <a class="btn-icon<?php echo \htmlentities(! empty( $class ) ? ' ' . $class : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" href="<?php echo \htmlentities($href??'', ENT_QUOTES, 'UTF-8', false); ?>"<?php if( ! empty( $inlineStyle ) ): ?> style="<?php echo \htmlentities(esc_attr( $inlineStyle )??'', ENT_QUOTES, 'UTF-8', false); ?>"<?php endif; ?><?php echo $attrs; ?>>
 <span class="txt"><?php echo \htmlentities(esc_html( $text )??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <span class="icon">
 <img src="<?php echo \htmlentities(esc_url( $iconUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </span>
 </a>
	<?php endif; ?>
<?php endif; ?>
