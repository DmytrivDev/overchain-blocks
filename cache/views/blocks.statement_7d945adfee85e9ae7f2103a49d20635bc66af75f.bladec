<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$imageUrl     = $attributes['imageUrl'] ?? '';
	$title        = $attributes['title'] ?? '';
	$lead         = $attributes['lead'] ?? '';
	$colOne       = $attributes['colOne'] ?? '';
	$colTwo       = $attributes['colTwo'] ?? '';

	$sectionClass = 'exists ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="exists__container">
 <div class="exists__wrap section-wrap">
 <?php if( ! empty( $imageUrl ) ): ?>
 <div class="exists__img no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>

 <div class="exists__body section-body<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <div class="exists__content">
 <?php if( ! empty( $lead ) ): ?>
 <div class="exists__lead txt2 medium">
 <p><?php echo wp_kses_post( $lead ); ?></p>
 </div>
 <?php endif; ?>

 <?php if( ! empty( $colOne ) || ! empty( $colTwo ) ): ?>
 <div class="exists__cols">
 <?php if( ! empty( $colOne ) ): ?>
 <div class="txt2 col-alt1">
 <p><?php echo wp_kses_post( $colOne ); ?></p>
 </div>
 <?php endif; ?>

 <?php if( ! empty( $colTwo ) ): ?>
 <div class="txt2 col-alt1">
 <p><?php echo wp_kses_post( $colTwo ); ?></p>
 </div>
 <?php endif; ?>
 </div>
 <?php endif; ?>
 </div>
 </div>
 </div>
	</div>
</section>
