<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';
	$text         = $attributes['text'] ?? '';

	$sectionClass = 'everything ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="everything__container">
 <div class="everything__wrap section-wrap">
 <div class="everything__body section-body<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if( ! empty( $title ) || ! empty( $text ) ): ?>
 <div class="heading aic">
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <?php if( ! empty( $text ) ): ?>
 <div class="txt2">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>
 </div>
 <?php endif; ?>

 <ul class="everything__list anim-cards" data-threshold-desktop="0.3">
 <?php echo overchain_blocks_stagger( $content, 'item-everything' ); ?>

 </ul>
 </div>
 </div>
	</div>
</section>
