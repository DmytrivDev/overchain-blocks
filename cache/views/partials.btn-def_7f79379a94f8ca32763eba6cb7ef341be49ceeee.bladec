<?php 
	$data = overchain_resolve_button_data( [
 'buttonType' => $type ?? 'link',
 'buttonLink' => $link ?? '',
 'buttonLinkNewTab' => $newTab ?? false,
 'buttonAnchor' => $anchor ?? '',
 'buttonPopupId' => $popupId ?? '',
	] );
	$href = $data['href'];
	$attrs = $data['attrs'];
	$class = $class ?? '';
	$style = $style ?? '';
	$inlineStyle = $inlineStyle ?? '';
 ?>

<?php if( ! empty( $text ?? '' ) ): ?>
	<a class="btn-def<?php echo \htmlentities(! empty( $style ) ? ' ' . $style : ''??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities(! empty( $class ) ? ' ' . $class : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" href="<?php echo \htmlentities($href??'', ENT_QUOTES, 'UTF-8', false); ?>"<?php if( ! empty( $inlineStyle ) ): ?> style="<?php echo \htmlentities(esc_attr( $inlineStyle )??'', ENT_QUOTES, 'UTF-8', false); ?>"<?php endif; ?><?php echo $attrs; ?>><?php echo \htmlentities(esc_html( $text )??'', ENT_QUOTES, 'UTF-8', false); ?></a>
<?php endif; ?>
