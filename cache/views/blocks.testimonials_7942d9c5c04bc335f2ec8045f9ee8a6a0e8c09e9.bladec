<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';
	$imageUrl     = $attributes['imageUrl'] ?? '';

	$sectionClass = 'testimonials ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="testimonials__container">
 <div class="testimonials__wrap section-wrap">
 <div class="testimonials__body section-body<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if( ! empty( $title ) ): ?>
 <div class="heading">
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 </div>
 <?php endif; ?>

 <div class="testimonials__main">
 <?php if( ! empty( $imageUrl ) ): ?>
 <div class="testimonials__img ibg">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>

 <div class="testimonials__window">
 <div class="testimonials__splide">
 <div class="splide" data-lock>
 <div class="splide__track">
 <ul class="splide__list">
 <?php echo $content; ?>

 </ul>
 </div>
 </div>

 <?php echo $this->runChild( 'partials.drag-arrow' ); ?>

 <?php echo $this->runChild( 'partials.splide-arrows' ); ?>
 </div>
 </div>
 </div>
 </div>
 </div>
	</div>
</section>
