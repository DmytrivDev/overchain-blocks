<?php 
	$imageUrl = $attributes['imageUrl'] ?? '';
	$title    = $attributes['title'] ?? '';
	$text     = $attributes['text'] ?? '';
	$tags     = $attributes['tags'] ?? [];

	// Empty rows are skipped, so `--i` has to count only the tags that print.
	$tagLabels = array_values( array_filter( array_map(
 static fn( $tag ) => $tag['label'] ?? '',
 is_array( $tags ) ? $tags : []
	) ) );

	$bgUrl = get_template_directory_uri() . '/assets/img/decor/powerful_blur_1.webp';
 ?>

<li class="card-powerful">
	<div class="card-powerful__bg no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $bgUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
	</div>

	<?php if( ! empty( $imageUrl ) ): ?>
 <div class="card-powerful__img no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
	<?php endif; ?>

	<?php if( ! empty( $title ) ): ?>
 <h3 class="card-powerful__tl tl3 regular"><?php echo wp_kses_post( $title ); ?></h3>
	<?php endif; ?>

	<?php if( ! empty( $text ) ): ?>
 <div class="card-powerful__desc txt2 col-alt1">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
	<?php endif; ?>

	<?php if( ! empty( $tagLabels ) ): ?>
 <?php /* Tags rise in one by one: blocks.css holds each `li` down until threshold.js
      adds `.is-threshold` to the list. */ ?>
 <ul class="card-powerful__tags" data-threshold-desktop="0.8">
 <?php $__currentLoopData = $tagLabels; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $tagIndex => $label): $loop = $this->incrementLoopIndices();  ?>
 <li style="--i: <?php echo \htmlentities((int) $tagIndex??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities(esc_html( $label )??'', ENT_QUOTES, 'UTF-8', false); ?></li>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </ul>
	<?php endif; ?>

	<?php echo $this->runChild( 'partials.btn-icon', [
 'text' => $attributes['buttonText'] ?? '',
 'type' => $attributes['buttonType'] ?? 'link',
 'link' => $attributes['buttonLink'] ?? '',
 'newTab' => $attributes['buttonLinkNewTab'] ?? false,
 'anchor' => $attributes['buttonAnchor'] ?? '',
 'popupId' => $attributes['buttonPopupId'] ?? '',
 'icon' => $attributes['buttonIcon'] ?? 'arrow',
 'class' => 'card-powerful__btn',
	] ); ?>
</li>
