<?php 
	$imageUrl = $attributes['imageUrl'] ?? '';
	$label    = $attributes['label'] ?? '';
	$tag      = $attributes['tag'] ?? '';
 ?>

<li class="card-operations">
	<?php if( ! empty( $imageUrl ) ): ?>
 <div class="card-operations__img ibg no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
	<?php endif; ?>

	<?php if( ! empty( $label ) || ! empty( $tag ) ): ?>
 <div class="card-operations__badge">
 <?php if( ! empty( $label ) ): ?>
 <p><?php echo \htmlentities(esc_html( wp_strip_all_tags( $label ) )??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <?php endif; ?>

 <?php if( ! empty( $tag ) ): ?>
 <span class="card-operations__tag"><?php echo \htmlentities(esc_html( wp_strip_all_tags( $tag ) )??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <?php endif; ?>
 </div>
	<?php endif; ?>
</li>
