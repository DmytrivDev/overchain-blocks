<?php 
	$iconUrl = $attributes['iconUrl'] ?? '';
	$title   = $attributes['title'] ?? '';
	$text    = $attributes['text'] ?? '';

	// Identical on all seven slides in the design — fixed theme asset, not an attribute.
	$cardBgUrl = get_template_directory_uri() . '/assets/img/decor/accept_bg_1.jpg';
 ?>

<li class="splide__slide card-accept">
	<div class="card-accept__bg ibg no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $cardBgUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="" loading="lazy" decoding="async">
	</div>

	<?php if( ! empty( $title ) || ! empty( $text ) ): ?>
 <div class="card-accept__content">
 <?php /* `h2`, not `h3`: the section has no heading of its own, so each step is a
      top-level item. Styling comes from `.card-accept__content .tl5`. */ ?>
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl5"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <?php if( ! empty( $text ) ): ?>
 <div class="card-accept__desc txt3 light">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>
 </div>
	<?php endif; ?>

	<?php /* Last in the DOM on purpose: `margin-block-start: auto` pins it to the bottom. */ ?>
	<?php if( ! empty( $iconUrl ) ): ?>
 <div class="card-accept__icon">
 <img src="<?php echo \htmlentities(esc_url( $iconUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
	<?php endif; ?>
</li>
