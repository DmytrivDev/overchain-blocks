<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$enableDecor  = $attributes['enableDecor'] ?? true;
	$title        = $attributes['title'] ?? '';
	$desc         = $attributes['desc'] ?? '';
	$note         = $attributes['note'] ?? '';
	// FM London: a second, plain button; then both sit in `.never__btns`.
 $secondaryText = $attributes['secondaryText'] ?? '';
 $imageUrl     = $attributes['imageUrl'] ?? '';

 $sectionClass = 'never ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );

 // Fixed design asset — the same shape Split's `layered` variant uses.
 $decorUrl = get_template_directory_uri() . '/assets/img/decor/foundation_decor_1.svg';

 // A fallback, not a placeholder: with nothing uploaded the front renders the
 // design's own illustration, which is what the canvas shows too.
 if ( empty( $imageUrl ) ) {
 $imageUrl = get_template_directory_uri() . '/assets/img/content/never_img_1.png';
 }
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="never__container">
 <div class="never__wrap section-wrap">
 <?php if( $enableDecor ): ?>
 <div class="never__decor no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $decorUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>

 <div class="never__body section-body<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="never__content">
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <?php /* Sits between the heading and the description, inside `__content`
      — not beside it. */ ?>
 <div class="never__img no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="" loading="lazy" decoding="async">
 </div>

 <?php if( ! empty( $desc ) ): ?>
 <div class="never__desc txt2">
 <p><?php echo wp_kses_post( $desc ); ?></p>
 </div>
 <?php endif; ?>

 <?php if( ! empty( $note ) ): ?>
 <div class="never__note txt3 col-alt1">
 <p><?php echo wp_kses_post( $note ); ?></p>
 </div>
 <?php endif; ?>

 <?php if( ! empty( $secondaryText ) ): ?>
 <div class="never__btns">
 <?php echo $this->runChild( 'partials.btn-icon', [
 'text' => $attributes['buttonText'] ?? '',
 'type' => $attributes['buttonType'] ?? 'link',
 'link' => $attributes['buttonLink'] ?? '',
 'newTab' => $attributes['buttonLinkNewTab'] ?? false,
 'anchor' => $attributes['buttonAnchor'] ?? '',
 'popupId' => $attributes['buttonPopupId'] ?? '',
 'icon' => $attributes['buttonIcon'] ?? 'arrow',
 'class' => 'never__btn',
 ] ); ?>

 <?php echo $this->runChild( 'partials.btn-def', [
 'text' => $secondaryText,
 'type' => $attributes['secondaryType'] ?? 'link',
 'link' => $attributes['secondaryLink'] ?? '',
 'newTab' => $attributes['secondaryLinkNewTab'] ?? false,
 'anchor' => $attributes['secondaryAnchor'] ?? '',
 'popupId' => $attributes['secondaryPopupId'] ?? '',
 'style' => 'stl-trn-clw',
 // BladeOne includes inherit the caller's variables: reset the
 // `class` the button above passed in.
 'class' => '',
 ] ); ?>
 </div>
 <?php else: ?>
 <?php echo $this->runChild( 'partials.btn-icon', [
 'text' => $attributes['buttonText'] ?? '',
 'type' => $attributes['buttonType'] ?? 'link',
 'link' => $attributes['buttonLink'] ?? '',
 'newTab' => $attributes['buttonLinkNewTab'] ?? false,
 'anchor' => $attributes['buttonAnchor'] ?? '',
 'popupId' => $attributes['buttonPopupId'] ?? '',
 'icon' => $attributes['buttonIcon'] ?? 'arrow',
 'class' => 'never__btn',
 ] ); ?>
 <?php endif; ?>
 </div>
 </div>
 </div>
	</div>
</section>
