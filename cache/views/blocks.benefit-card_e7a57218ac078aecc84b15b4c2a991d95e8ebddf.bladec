<?php 
	$title    = $attributes['title'] ?? '';
	$text     = $attributes['text'] ?? '';
	$wide     = ! empty( $attributes['wide'] );
	$imageUrl = $attributes['imageUrl'] ?? '';
 ?>

<?php /* `--i` for the staggered reveal is added by the parent (overchain_blocks_stagger()).
 A wide card spans two columns; only wide cards show the image. */ ?>
<li class="card-delays<?php echo \htmlentities($wide ? ' wide' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<?php if( $wide && ! empty( $imageUrl ) ): ?>
 <div class="card-delays__img no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="" loading="lazy" decoding="async">
 </div>
	<?php endif; ?>

	<?php if( ! empty( $title ) ): ?>
 <h3 class="tl4"><?php echo wp_kses_post( $title ); ?></h3>
	<?php endif; ?>

	<?php if( ! empty( $text ) ): ?>
 <div class="txt2">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
	<?php endif; ?>
</li>
