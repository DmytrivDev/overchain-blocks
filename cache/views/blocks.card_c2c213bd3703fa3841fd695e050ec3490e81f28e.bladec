<?php 
	$iconUrl = $attributes['iconUrl'] ?? '';
	$title   = $attributes['title'] ?? '';
	$text    = $attributes['text'] ?? '';
 ?>

<li class="card-compliant">
	<?php if( ! empty( $iconUrl ) ): ?>
 <div class="card-compliant__icon">
 <img src="<?php echo \htmlentities(esc_url( $iconUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
	<?php endif; ?>

	<div class="card-compliant__box">
 <?php if( ! empty( $title ) ): ?>
 <h3 class="tl5"><?php echo wp_kses_post( $title ); ?></h3>
 <?php endif; ?>

 <?php if( ! empty( $text ) ): ?>
 <div class="txt3 light">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>
	</div>
</li>