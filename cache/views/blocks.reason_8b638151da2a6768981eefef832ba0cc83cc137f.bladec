<?php 
	$iconUrl = $attributes['iconUrl'] ?? '';
	$title   = $attributes['title'] ?? '';
	$text    = $attributes['text'] ?? '';
 ?>

<?php /* `--i` for the staggered reveal is added by the parent (overchain_blocks_stagger()). */ ?>
<li class="card-brokers">
	<?php if( ! empty( $iconUrl ) ): ?>
 <div class="card-brokers__icon">
 <img src="<?php echo \htmlentities(esc_url( $iconUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
	<?php endif; ?>

	<div class="card-brokers__box">
 <?php if( ! empty( $title ) ): ?>
 <h3 class="tl4 regular"><?php echo wp_kses_post( $title ); ?></h3>
 <?php endif; ?>

 <?php if( ! empty( $text ) ): ?>
 <div class="txt3 light col-alt1">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>
	</div>
</li>
