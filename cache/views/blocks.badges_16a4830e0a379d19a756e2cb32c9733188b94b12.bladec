<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';
	$decoLeftUrl  = $attributes['decoLeftUrl'] ?? '';
	$decoRightUrl = $attributes['decoRightUrl'] ?? '';
	$badges       = $attributes['badges'] ?? [];

	$sectionClass = 'operation ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
	$bgUrl        = get_template_directory_uri() . '/assets/img/decor/operation_bg_1.svg';
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="operation__container">
 <div class="operation__wrap">
 <div class="operation__bg no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $bgUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>

 <div class="operation__decor decor1 no-select" aria-hidden="true"></div>
 <div class="operation__decor decor2 no-select" aria-hidden="true"></div>

 <div class="operation__body section-body">
 <?php if( ! empty( $decoLeftUrl ) ): ?>
 <div class="operation__img img1 no-select mouse-prllx" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $decoLeftUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>

 <?php if( ! empty( $decoRightUrl ) ): ?>
 <div class="operation__img img2 no-select mouse-prllx reverse" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $decoRightUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>

 <?php if( ! empty( $title ) ): ?>
 <div class="heading aic">
 <h2 class="tl2"><?php echo wp_kses_post( $title ); ?></h2>
 </div>
 <?php endif; ?>

 <?php if( ! empty( $badges ) ): ?>
 <ul class="operation__list">
 <?php $__currentLoopData = $badges; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $badge): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $iconUrl = $badge['iconUrl'] ?? '';
 $label   = $badge['label'] ?? '';
  ?>

 <?php if( ! empty( $label ) ): ?>
 <li class="item-operation">
 <?php if( ! empty( $iconUrl ) ): ?>
 <img src="<?php echo \htmlentities(esc_url( $iconUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 <?php endif; ?>

 <p><?php echo \htmlentities(esc_html( $label )??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 </li>
 <?php endif; ?>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </ul>
 <?php endif; ?>
 </div>
 </div>
	</div>
</section>