<?php 
	$date    = $attributes['date'] ?? '';
	$place   = $attributes['place'] ?? '';
	$title   = $attributes['title'] ?? '';
	$link    = $attributes['link'] ?? '';
	$text    = $attributes['text'] ?? '';
	$logoUrl = $attributes['logoUrl'] ?? '';

	// The card backdrop and the glow are the design's fixed artwork, shipped in the theme.
	$decor = get_template_directory_uri() . '/assets/img/decor/';
 ?>

<li class="card-events">
	<div class="card-events__aside">
 <div class="card-events__part">
 <?php if( ! empty( $date ) ): ?>
 <h3 class="card-events__dates tl5"><?php echo wp_kses_post( $date ); ?></h3>
 <?php endif; ?>
 </div>
 <div class="card-events__part">
 <?php if( ! empty( $place ) ): ?>
 <p class="card-events__local"><?php echo wp_kses_post( $place ); ?></p>
 <?php endif; ?>
 </div>
 <div class="card-events__dashed" aria-hidden="true"></div>
	</div>

	<div class="card-events__main">
 <div class="card-events__content">
 <div class="card-events__part">
 <?php /* The design's headline is a link styled as a heading; without a link
      it stays the same element, just not clickable. */ ?>
 <?php if( ! empty( $title ) ): ?>
 <a <?php if( ! empty( $link ) ): ?> href="<?php echo \htmlentities(esc_url( $link )??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php endif; ?>role="heading" aria-level="2" class="tl3"><?php echo wp_kses_post( $title ); ?></a>
 <?php endif; ?>

 <?php if( ! empty( $text ) ): ?>
 <div class="txt3 light">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>
 </div>
 </div>

 <div class="card-events__image">
 <div class="card-events__bg ibg no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $decor . 'card-events_bg_1.jpg' )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php if( ! empty( $logoUrl ) ): ?>
 <div class="card-events__img">
 <img src="<?php echo \htmlentities(esc_url( $logoUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>
 </div>
	</div>

	<div class="card-events__blur no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $decor . 'settlement_blur_2.webp' )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
	</div>
</li>
