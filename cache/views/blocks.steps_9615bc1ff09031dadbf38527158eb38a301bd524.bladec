<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';
	$subtitle     = $attributes['subtitle'] ?? '';
	$steps        = $attributes['steps'] ?? [];

	$sectionClass = 'oneflow ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
	$decorUrl     = get_template_directory_uri() . '/assets/img/decor/oneflow_dec_1.jpg';
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="oneflow__container">
 <div class="oneflow__wrap">
 <div class="oneflow__decor decor1 no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $decorUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>

 <div class="oneflow__body section-body">
 <div class="heading aic">
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl2"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <?php if( ! empty( $subtitle ) ): ?>
 <div class="txt4 col-alt1">
 <p><?php echo wp_kses_post( $subtitle ); ?></p>
 </div>
 <?php endif; ?>
 </div>

 <?php if( ! empty( $steps ) ): ?>
 <div class="oneflow__layout" data-threshold-desktop="0.4">
 <div class="oneflow__line" aria-hidden="true"></div>

 <ul class="oneflow__steps">
 <?php $__currentLoopData = $steps; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $index => $step): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $iconUrl = $step['iconUrl'] ?? '';
 $label   = $step['label'] ?? '';
 $number  = str_pad( (string) ( $index + 1 ), 2, '0', STR_PAD_LEFT );
  ?>

 <li class="item-oneflow">
 <?php if( ! empty( $iconUrl ) ): ?>
 <div class="item-oneflow__icon">
 <img src="<?php echo \htmlentities(esc_url( $iconUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>

 <div class="item-oneflow__box">
 <?php if( ! empty( $label ) ): ?>
 <h3 class="item-oneflow__tl"><?php echo wp_kses_post( $label ); ?></h3>
 <?php endif; ?>

 <p class="item-oneflow__step"><?php echo \htmlentities(esc_html( $number )??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 </div>
 </li>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </ul>
 </div>
 <?php endif; ?>
 </div>
 </div>
	</div>
</section>