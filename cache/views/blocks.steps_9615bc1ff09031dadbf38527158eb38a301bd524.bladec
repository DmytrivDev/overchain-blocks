<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';
	$subtitle     = $attributes['subtitle'] ?? '';
	$steps        = $attributes['steps'] ?? [];

	// A fresh block arrives with four empty steps. An untouched row would still print
	// its number, so drop the ones with neither a label nor an icon — `array_values`
	// keeps the numbering sequential afterwards.
	$steps = array_values( array_filter(
 is_array( $steps ) ? $steps : [],
 function ( $step ) {
 return ! empty( $step['label'] ) || ! empty( $step['iconUrl'] );
 }
	) );

	$sectionClass = 'oneflow ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
	$decorUrl     = get_template_directory_uri() . '/assets/img/decor/oneflow_dec_1.jpg';
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="oneflow__container">
 <div class="oneflow__wrap section-wrap">
 <div class="oneflow__decor decor1 no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $decorUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>

 <div class="oneflow__body section-body<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="heading aic">
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <?php if( ! empty( $subtitle ) ): ?>
 <div class="txt4 col-alt1">
 <p><?php echo wp_kses_post( $subtitle ); ?></p>
 </div>
 <?php endif; ?>
 </div>

 <?php if( ! empty( $steps ) ): ?>
 <div class="oneflow__layout" data-threshold-desktop="0.4">
 <div class="oneflow__line" aria-hidden="true"></div>

 <ul class="oneflow__steps">
 <?php $__currentLoopData = $steps; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $index => $step): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $iconUrl = $step['iconUrl'] ?? '';
 $label   = $step['label'] ?? '';
 $number  = str_pad( (string) ( $index + 1 ), 2, '0', STR_PAD_LEFT );

 // "USDT, BTC, ETH" → a word cycler after the title (theme
 // auto-swap.js). The icon cycles in step with it: the design
 // repeats the same icon once per word, and `data-swap-group`
 // gives both tracks one shared timer and index.
 $swapWords = array_values( array_filter( array_map(
 'trim',
 explode( ',', (string) ( $step['swapWords'] ?? '' ) )
 ), 'strlen' ) );
 $hasSwap = count( $swapWords ) > 1;
  ?>

 <li class="item-oneflow"<?php if( $hasSwap ): ?> data-swap-group <?php endif; ?>>
 <?php if( ! empty( $iconUrl ) ): ?>
 <div class="item-oneflow__icon">
 <?php if( $hasSwap ): ?>
 <span class="auto-swap-items">
 <span>
 <?php $__currentLoopData = $swapWords; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $word): $loop = $this->incrementLoopIndices();  ?>
 <span><img src="<?php echo \htmlentities(esc_url( $iconUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt=""></span>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </span>
 </span>
 <?php else: ?>
 <img src="<?php echo \htmlentities(esc_url( $iconUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 <?php endif; ?>
 </div>
 <?php endif; ?>

 <div class="item-oneflow__box">
 <?php if( ! empty( $label ) || $hasSwap ): ?>
 <h3 class="item-oneflow__tl">
 <?php echo wp_kses_post( $label ); ?>

 <?php if( $hasSwap ): ?>
 <span class="auto-swap-items">
 <span>
 <?php $__currentLoopData = $swapWords; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $word): $loop = $this->incrementLoopIndices();  ?>
 <span><?php echo \htmlentities(esc_html( $word )??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </span>
 </span>
 <?php endif; ?>
 </h3>
 <?php endif; ?>

 <p class="item-oneflow__step"><?php echo \htmlentities(esc_html( $number )??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 </div>
 </li>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </ul>
 </div>
 <?php endif; ?>
 </div>
 </div>
	</div>
</section>