<?php 
	$name      = $attributes['name'] ?? '';
	$role      = $attributes['role'] ?? '';
	$avatarUrl = $attributes['avatarUrl'] ?? '';

	// The 2026-10 design drop removed the intro text card (`.card-understand.intro`)
	// and its styles. `variant` is no longer in block.json, but WordPress still passes
	// attributes stored in the block comment, so cards saved as intro would otherwise
	// render as an empty person card. Print nothing until an editor deletes them.
	$isLegacyIntro = 'intro' === ( $attributes['variant'] ?? '' );

	// A person with no photo falls back to the centred placeholder icon.
	$defaultIconUrl = get_template_directory_uri() . '/assets/img/icons/ava_def_1.svg';
 ?>

<?php if( ! $isLegacyIntro ): ?>
	<li class="splide__slide card-understand">
 <?php if( ! empty( $avatarUrl ) ): ?>
 <div class="card-understand__img ibg no-select">
 <img src="<?php echo \htmlentities(esc_url( $avatarUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="" loading="lazy" decoding="async">
 </div>
 <?php else: ?>
 <div class="card-understand__icon no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $defaultIconUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>

 <div class="card-understand__content">
 <?php if( ! empty( $name ) ): ?>
 <h3 class="card-understand__name"><?php echo \htmlentities(esc_html( wp_strip_all_tags( $name ) )??'', ENT_QUOTES, 'UTF-8', false); ?></h3>
 <?php endif; ?>

 <?php if( ! empty( $role ) ): ?>
 <p class="card-understand__role"><?php echo \htmlentities(esc_html( wp_strip_all_tags( $role ) )??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <?php endif; ?>
 </div>
	</li>
<?php endif; ?>
