<?php 
	$noPaddingTop  = $attributes['noPaddingTop'] ?? false;
	$title         = $attributes['title'] ?? '';
	$backgroundUrl = $attributes['backgroundUrl'] ?? '';

	$sectionClass = 'control ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="control__container">
 <div class="control__wrap">
 <div class="control__decor no-select" aria-hidden="true"></div>

 <div class="control__body section-body">
 <?php if( ! empty( $title ) ): ?>
 <div class="heading">
 <h2 class="tl2"><?php echo wp_kses_post( $title ); ?></h2>
 </div>
 <?php endif; ?>

 <ul class="control__list">
 <?php echo $content; ?>

 </ul>

 <?php if( ! empty( $backgroundUrl ) ): ?>
 <div class="control__img no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $backgroundUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="">
 </div>
 <?php endif; ?>
 </div>
 </div>
	</div>
</section>