<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';
	$text         = $attributes['text'] ?? '';

	$sectionClass = 'understand ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="understand__container">
 <div class="understand__wrap section-wrap">
 <div class="understand__body section-body<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if( ! empty( $title ) || ! empty( $text ) ): ?>
 <div class="heading<?php echo \htmlentities(! empty( $attributes['centerHeading'] ) ? ' aic' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if( ! empty( $title ) ): ?>
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 <?php endif; ?>

 <?php if( ! empty( $text ) ): ?>
 <div class="txt2">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
 <?php endif; ?>
 </div>
 <?php endif; ?>

 <div class="understand__splide">
 <div class="splide" data-lock>
 <div class="splide__track">
 <ul class="splide__list">
 <?php echo $content; ?>

 </ul>
 </div>
 </div>

 <?php echo $this->runChild( 'partials.drag-arrow' ); ?>
 </div>
 </div>
 </div>
	</div>
</section>
