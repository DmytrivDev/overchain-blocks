<?php 
	$title    = $attributes['title'] ?? '';
	$text     = $attributes['text'] ?? '';
	$imageUrl = $attributes['imageUrl'] ?? '';
 ?>

<?php /* `--i` for the staggered reveal is added by the parent (overchain_blocks_stagger()). */ ?>
<li class="card-institution">
	<?php /* The glow is the design's fixed artwork, shipped in the theme. */ ?>
	<div class="card-institution__blur no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( get_template_directory_uri() . '/assets/img/decor/institution_blur_1.webp' )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="" loading="lazy" decoding="async">
	</div>

	<?php if( ! empty( $title ) ): ?>
 <h3 class="tl4"><?php echo wp_kses_post( $title ); ?></h3>
	<?php endif; ?>

	<?php if( ! empty( $text ) ): ?>
 <div class="txt3 col-alt1">
 <p><?php echo wp_kses_post( $text ); ?></p>
 </div>
	<?php endif; ?>

	<?php if( ! empty( $imageUrl ) ): ?>
 <div class="card-institution__img no-select" aria-hidden="true">
 <img src="<?php echo \htmlentities(esc_url( $imageUrl )??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="" loading="lazy" decoding="async">
 </div>
	<?php endif; ?>
</li>
