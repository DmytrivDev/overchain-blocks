<?php 
	$noPaddingTop = $attributes['noPaddingTop'] ?? false;
	$title        = $attributes['title'] ?? '';
	$sectionClass = 'institution ' . ( $noPaddingTop ? 'pbs4' : 'pbs2' );
 ?>

<section class="<?php echo \htmlentities(esc_attr( $sectionClass )??'', ENT_QUOTES, 'UTF-8', false); ?>">
	<div class="institution__container">
 <div class="institution__wrap section-wrap<?php echo \htmlentities(overchain_blocks_fade_class( $attributes )??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="institution__body section-body">
 <?php if( ! empty( $title ) ): ?>
 <div class="heading mbe2">
 <h2 class="tl2 anim-txt"><?php echo wp_kses_post( $title ); ?></h2>
 </div>
 <?php endif; ?>

 <?php if( '' !== trim( $content ) ): ?>
 <ul class="institution__cards anim-cards" role="list" data-threshold-desktop="0.3">
 <?php echo overchain_blocks_stagger( $content, 'card-institution' ); ?>

 </ul>
 <?php endif; ?>
 </div>
 </div>
	</div>
</section>
