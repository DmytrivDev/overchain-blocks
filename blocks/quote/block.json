{
  "apiVersion": 3,
  "name": "overchain/quote",
  "title": "Designed Quote",
  "category": "overchain-post-blocks",
  "icon": "format-quote",
  "description": "Quote block with text and author.",
  "textdomain": "overchain-blocks",
  "supports": {
    "html": false,
    "align": false
  },
  "example": {
    "viewportWidth": 1400,
    "attributes": {
      "quote": "Traditional banking systems and credit card networks require substantial energy for their infrastructure.",
      "author": "Tyler Betts",
      "position": "Chief Compliance Officer"
    }
  },
  "attributes": {
    "noPaddingTop": {
      "type": "boolean",
      "default": false
    },
    "disableWhiteFade": {
      "type": "boolean",
      "default": false
    },
    "quote": {
      "type": "string",
      "default": ""
    },
    "author": {
      "type": "string",
      "default": ""
    },
    "position": {
      "type": "string",
      "default": ""
    },
    "avatarId": {
      "type": "number",
      "default": 0
    },
    "avatarUrl": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:../../build/quote/index.js",
  "render": "file:./render.php"
}
