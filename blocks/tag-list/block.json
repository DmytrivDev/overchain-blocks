      "text": "Infrastructure shouldn't become more complex as your business grows.",
      "tags": [
        {
          "label": "High-volume processing"
        },
        {
          "label": "Mass payouts"
        },
        {
          "label": "Multi-currency settlement"
        },
        {
          "label": "API-first architecture"
        }
      ]
    }
  },
  "attributes": {
