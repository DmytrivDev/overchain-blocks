{
  "apiVersion": 3,
  "name": "overchain/callout",
  "title": "Callout",
  "category": "overchain",
  "icon": "megaphone",
  "description": "Closing call to action: image, heading, text and a button.",
  "textdomain": "overchain-blocks",
  "supports": {
    "html": false,
    "align": false
  },
  "example": {
    "viewportWidth": 1200,
    "attributes": {
      "title": "Don&#8217;t See the Right Fit?",
      "text": "We&#8217;re always looking for great talent to join the team.",
      "buttonText": "Send Application"
    }
  },
  "attributes": {
    "noPaddingTop": {
      "type": "boolean",
      "default": false
    },
    "disableWhiteFade": {
      "type": "boolean",
      "default": false
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "buttonText": {
      "type": "string",
      "default": ""
    },
    "buttonType": {
      "type": "string",
      "default": "link"
    },
    "buttonLink": {
      "type": "string",
      "default": ""
    },
    "buttonLinkId": {
      "type": "number",
      "default": 0
    },
    "buttonLinkTitle": {
      "type": "string",
      "default": ""
    },
    "buttonLinkNewTab": {
      "type": "boolean",
      "default": false
    },
    "buttonAnchor": {
      "type": "string",
      "default": ""
    },
    "buttonPopupId": {
      "type": "string",
      "default": ""
    },
    "buttonIcon": {
      "type": "string",
      "default": "arrow"
    }
  },
  "editorScript": "file:../../build/callout/index.js",
  "render": "file:./render.php"
}
