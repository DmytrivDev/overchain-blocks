{
  "apiVersion": 3,
  "name": "overchain/related-posts",
  "title": "Related Posts",
  "category": "overchain",
  "icon": "grid-view",
  "description": "Related posts section.",
  "textdomain": "overchain-blocks",
  "supports": {
    "html": false,
    "align": false
  },
  "example": {
    "viewportWidth": 1200,
    "attributes": {
      "title": "Related Articles"
    }
