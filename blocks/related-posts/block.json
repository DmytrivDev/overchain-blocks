  "attributes": {
    "noPaddingTop": {
      "type": "boolean",
      "default": false
    },
    "title": {
      "type": "string",
      "default": "Related Articles"
    },
    "sourceType": {
      "type": "string",
      "default": "latest"
    },
    "postsCount": {
      "type": "number",
      "default": 4
    },
    "selectedPosts": {
      "type": "array",
      "default": []
    }
  },
  "editorScript": "file:../../build/related-posts/index.js",
  "render": "file:./render.php"
}