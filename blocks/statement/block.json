{
  "apiVersion": 3,
  "name": "overchain/statement",
  "title": "Statement",
  "category": "overchain",
  "icon": "editor-alignleft",
  "description": "Side image with a lead paragraph and two text columns.",
  "textdomain": "overchain-blocks",
  "supports": {
    "html": false,
    "align": false
  },
  "example": {
