    "imageId": {
      "type": "number",
      "default": 0
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "lead": {
      "type": "string",
      "default": ""
    },
    "colOne": {
      "type": "string",
      "default": ""
    },
    "colTwo": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:../../build/statement/index.js",
  "render": "file:./render.php"
}
